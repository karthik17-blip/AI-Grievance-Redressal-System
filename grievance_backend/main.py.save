from fastapi import FastAPI
from fastapi.middle
# -------------------------------
# Create database tables
# -------------------------------
Base.metadata.create_all(bind=engine)


# -------------------------------
# Initialize FastAPI
# -------------------------------
app = FastAPI()


# -------------------------------
# Enable CORS
# -------------------------------
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# -------------------------------
# Load AI model
# -------------------------------
model_path = "./grievance_model"

tokenizer = AutoTokenizer.from_pretrained(model_path)
model = AutoModelForSequenceClassification.from_pretrained(model_path)


# -------------------------------
# Labels
# -------------------------------
labels = [
    "Education",
    "Electricity",
    "Health Services",
    "Pension & Social Welfare",
    "Roads & Infrastructure",
    "Sanitation",
    "Telecommunications",
    "Water Supply"
]


# -------------------------------
# Department Mapping
# -------------------------------
department_mapping = {
    "Water Supply": "Water Authority",
    "Electricity": "Electricity Board",
    "Roads & Infrastructure": "Municipal Corporation",
    "Health Services": "Health Department",
    "Education": "Education Department",
    "Sanitation": "Sanitation Department",
    "Telecommunications": "Telecom Authority",
    "Pension & Social Welfare": "Social Welfare Department"
}


# -------------------------------
# Input schema
# -------------------------------
class TextInput(BaseModel):
    text: str


# -------------------------------
# Predict API
# -------------------------------
@app.post("/predict")
def classify_grievance(input: TextInput):

    text = input.text

    model.eval()

    inputs = tokenizer(
        text,
        return_tensors="pt",
        truncation=True,
        padding=True,
        max_length=128
    )

    with torch.no_grad():
        outputs = model(**inputs)

    logits = outputs.logits
    probs = F.softmax(logits, dim=1)

    confidence, prediction = torch.max(probs, dim=1)

    predicted_label = labels[prediction.item()]
    category_confidence = round(confidence.item(), 4)

    # simple urgency rule
    urgency = "Low"
    urgency_confidence = 1

    if "urgent" in text.lower() or "danger" in text.lower():
        urgency = "High"

    # Department mapping
    assigned_department = department_mapping[predicted_label]

    # Duplicate detection
    duplicate_result = check_duplicate(text)

    similarity_score = duplicate_result["similarity_score"]

    # -------------------------------
    # Save complaint to database
    # -------------------------------
    db = SessionLocal()

    new_complaint = Complaint(
        text=text,
        category=predicted_label,
        urgency=urgency,
        department=assigned_department,
        similarity_score=similarity_score
    )

    db.add(new_complaint)
    db.commit()
    db.close()

    # -------------------------------
    # API response
    # -------------------------------
    return {
        "text": text,
        "predicted_category": predicted_label,
        "category_confidence": category_confidence,
        "urgency": urgency,
        "urgency_confidence": urgency_confidence,
        "assigned_department": assigned_department,
        "duplicate_info": duplicate_result
    }


# -------------------------------
# Get all complaints (Dashboard API)
# -------------------------------
@app.get("/complaints")
def get_all_complaints():

    db = SessionLocal()

    complaints = db.query(Complaint).all()

    results = []

    for c in complaints:
        results.append({
            "id": c.id,
            "text": c.text,
            "category": c.category,
            "urgency": c.urgency,
            "department": c.department,
            "similarity_score": c.similarity_score
        })

    db.close()

    return results
